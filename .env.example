
# ==========================================
# SQL SERVER CONNECTION
# ==========================================

DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_NAME=YourDatabase

# Windows Integrated Authentication or SQL Authentication
DB_TRUSTED_CONNECTION=yes
DB_USERNAME=
DB_PASSWORD=

# Connection security
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no

# ==========================================
# DATABASE TABLE AND COLUMNS
# ==========================================

DB_TABLE=dbo.YourTable
DB_ID_COLUMN=YourRecordID
DB_SOURCE_COLUMN=YourCompressedRtfColumn
DB_HTML_COLUMN=YourHtmlColumn

# ==========================================
# RTF2HTML EXECUTABLE
# ==========================================

RTF2HTML_EXE=C:/Tools/rtf2html/rtf2html.exe

# ==========================================
# PROCESSING SETTINGS
# ==========================================

# Number of records retrieved per batch
FETCH_BATCH_SIZE=100

# Database retry settings
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2

# Timeout settings
DB_CONNECTION_TIMEOUT_SECONDS=15
DB_QUERY_TIMEOUT_SECONDS=0
RTF2HTML_TIMEOUT_SECONDS=120

# ==========================================
# SAFETY SETTINGS
# ==========================================

# Set to yes to test without updating SQL Server
DRY_RUN=no

# Stop conversion if embedded image files are detected
FAIL_ON_EXTRACTED_IMAGES=yes

# ==========================================
# LOGGING
# ==========================================

LOG_FILE=rtf_conversion.log
